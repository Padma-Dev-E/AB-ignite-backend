{
  "name": "@ab-ignite/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api:build": "tsc --noEmit -p apps/api/tsconfig.json",
    "api:start": "node --import dotenv/config --conditions=react-server --import tsx apps/api/src/server.ts",
    "api:dev": "node --import dotenv/config --conditions=react-server --import tsx --watch apps/api/src/server.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "argon2": "^0.45.1",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "next-auth": "^5.0.0-beta.32",
    "server-only": "^0.0.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.30",
    "drizzle-kit": "^0.31.5",
    "typescript": "^5.8.3"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "better-sqlite3@12.11.1": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true
  }
}
