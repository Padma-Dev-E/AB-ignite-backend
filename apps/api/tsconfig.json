{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "resolveJsonModule": true,
    "noEmit": true,
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts", "../../types/**/*.d.ts"],
  "exclude": ["../../node_modules"]
}
