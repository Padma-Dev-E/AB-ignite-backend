AUTH_URL=http://localhost:3100
# LOCAL DEVELOPMENT ONLY. Replace every local-only secret/value before any non-local use.
NODE_ENV=development
DATABASE_URL=./data/ab-ignite.db
AUTH_SECRET=LOCAL-ONLY-DO-NOT-USE-OUTSIDE-DEV-auth-secret-7d2f91c4
INTERNAL_API_TOKEN=LOCAL-ONLY-DO-NOT-USE-OUTSIDE-DEV-internal-token-4a8c63e1
AUTH_SESSION_COOKIE_NAME=ab_ignite_session
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_SESSION_IDLE_SECONDS=1800
AUTH_SESSION_ABSOLUTE_SECONDS=28800
AUTH_REFRESH_COOKIE_NAME=ab_ignite_refresh
AUTH_AUDIT_HASH_SECRET=LOCAL-ONLY-DO-NOT-USE-OUTSIDE-DEV-audit-secret-5b3e90a2
DEFAULT_ADMIN_EMAIL=admin@admin.com
DEFAULT_ADMIN_PASSWORD=LocalOnly-Admin-ChangeMe-123!
DEMO_ACCESS_ENABLED=false
DEMO_SESSION_TTL_SECONDS=3600
API_HOST=127.0.0.1
API_PORT=4100
API_TRUST_PROXY=127.0.0.1,::1
API_ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
API_MAX_BODY_BYTES=1048576
API_LOG_REQUESTS=true
# Set GEMINI_API_KEY privately in your local .env to enable Gemini calls. Never commit it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_BASE_URL=
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_ATTEMPTS=3
GEMINI_RETRY_INITIAL_DELAY_MS=250
GEMINI_RETRY_MAX_DELAY_MS=4000
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_TEMPERATURE=0
AI_MAX_INPUT_CHARS=30000
AI_MAX_OUTPUT_BYTES=200000
AI_ALLOWED_DATA_CLASSIFICATION=internal
AI_LOG_SENSITIVE=false
AI_RATE_LIMIT_PER_USER=20
AI_GLOBAL_CONCURRENCY=4
AI_RETENTION_DAYS=90
# Unique ID for the worker loop running inside this backend API process; this is not a separate service.
AI_WORKER_ID=ab-ignite-backend-api-local
AI_WORKER_POLL_INTERVAL_MS=1000
AI_WORKER_STALE_AFTER_MS=60000
